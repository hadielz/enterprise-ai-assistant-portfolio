        "tool-selection",
        "no-tool"
      ]
    },
    {
      "id": "tool-malformed-selection-output-v1c",
      "description": "Malformed tool-selection output must remain distinguishable from a valid no-tool decision.",
      "target": "tool_selector_controlled",
      "status": "active",
      "required": true,
      "input": {
        "message": "Calculate 10 + 15.",
        "provider_output": "calculator(10 + 15)"
      },
      "evaluators": [
        {
          "name": "exact_match",
          "config": {
            "path": "selection_status",
            "expected": "parse_error"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "valid_no_tool_decision",
            "expected": false
          }
        }
      ],
      "tags": [
        "v1c",
        "tool-selection",
        "malformed-json"
      ],
      "notes": "Activated in v1C Phase 2. Production routing remains legacy-compatible while the selector result now preserves parse_error explicitly."
    },
    {
      "id": "tool-selector-fenced-json-v1c",
      "description": "A complete Markdown-fenced JSON tool-selection response is normalized and classified as selected.",
      "target": "tool_selector_controlled",
      "status": "active",
      "required": true,
      "input": {
        "message": "Calculate 5 * 6.",
        "provider_output": "```json\n{\"tool_name\": \"calculator\", \"tool_input\": \"5 * 6\"}\n```"
      },
      "evaluators": [
        {
          "name": "exact_match",
          "config": {
            "path": "selection_status",
            "expected": "selected"
          }
        },
        {
          "name": "tool_match",
          "config": {
            "expected": "calculator"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "tool_input",
            "expected": "5 * 6"
          }
        }
      ],
      "tags": [
        "v1c",
        "tool-selection",
        "fenced-json"
      ],
      "notes": "Updated during R2 live-provider verification after Gemini returned an otherwise valid tool-selection JSON object wrapped in a complete Markdown JSON fence. Only a complete fence is normalized; arbitrary prose around JSON and malformed JSON remain parse errors."
    },
