APP_NAME=Enterprise AI Assistant
APP_VERSION=1.0.0
APP_ENV=local
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDERS=openai,ollama

OPENAI_API_KEY=replace-with-an-openai-api-key
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

GEMINI_API_KEY=replace-with-a-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# Vector storage: local default remains Chroma. Cloud deployment uses pgvector.
VECTOR_STORE_BACKEND=chroma
VECTOR_DISTANCE_THRESHOLD=1.2
CHROMA_PATH=data/chroma

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development PostgreSQL database
POSTGRES_DB=enterprise_ai
POSTGRES_USER=enterprise_ai
POSTGRES_PASSWORD=replace-with-a-secure-password
DATABASE_URL=postgresql+psycopg://enterprise_ai:replace-with-a-secure-password@postgres:5432/enterprise_ai
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Dedicated PostgreSQL database used only by automated tests
TEST_DATABASE_URL=postgresql+psycopg://enterprise_ai_test:enterprise_ai_test@postgres-test:5432/enterprise_ai_test

# MCP local default. Cloud uses google_identity with a Cloud Run audience.
MCP_TICKET_URL=http://mcp-server:8001/mcp
MCP_AUTH_MODE=none
MCP_AUDIENCE=
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001

# Observability. Local tests keep this disabled; cloud uses gcp_otlp.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=enterprise-ai-backend
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.googleapis.com:443/v1/traces
OTEL_SAMPLE_RATIO=0.1
GOOGLE_CLOUD_PROJECT=

# R4 bounded process-local rate limiting. Local default stays disabled so
# automated tests/dev workflows are deterministic; cloud deployment enables it.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REGISTER_LIMIT=20
RATE_LIMIT_REGISTER_WINDOW_SECONDS=600
RATE_LIMIT_LOGIN_GLOBAL_LIMIT=60
RATE_LIMIT_LOGIN_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_USER_LIMIT=10
RATE_LIMIT_LOGIN_USER_WINDOW_SECONDS=300
RATE_LIMIT_CHAT_LIMIT=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_RAG_INDEX_LIMIT=3
RATE_LIMIT_RAG_INDEX_WINDOW_SECONDS=3600
RATE_LIMIT_TICKET_STATUS_LIMIT=30
RATE_LIMIT_TICKET_STATUS_WINDOW_SECONDS=60
