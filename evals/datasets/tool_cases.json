            ]
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "selection_status",
            "expected": "parse_error"
          }
        },
        {
          "name": "tool_match",
          "config": {
            "expected": null
          }
        }
      ],
      "tags": [
        "v1c",
        "provider-fallback",
        "protocol-boundary",
        "parse-error",
        "phase3"
      ],
      "notes": "Provider execution success and tool-protocol validity are intentionally separate contracts."
    }
  ]
