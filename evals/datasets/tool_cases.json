            "model_name": "primary-model",
            "behavior": "raise_error",
            "response": "",
            "error_message": "primary unavailable"
          },
          {
            "configured_name": "fallback",
            "provider_name": "fallback-provider",
            "model_name": "fallback-model",
            "behavior": "raise_error",
            "response": "",
            "error_message": "fallback unavailable"
          }
        ]
      },
      "evaluators": [
        {
          "name": "exact_match",
