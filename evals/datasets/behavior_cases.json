{
  "name": "behavior_cases",
  "description": "Security, parity, ambiguity, and broader application-behaviour contracts.",
  "cases": [
    {
      "id": "behavior-cross-user-isolation-001",
      "description": "A user must not be able to read another user's conversation.",
      "target": "contract_fixture",
      "status": "active",
      "required": true,
      "input": {
        "owner_user_id": 10,
        "requesting_user_id": 20,
        "conversation_id": "private-conversation"
      },
      "fixture_output": {
        "status_code": 404,
        "conversation_returned": false
      },
      "evaluators": [
        {
          "name": "exact_match",
          "config": {
            "path": "status_code",
            "expected": 404
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "conversation_returned",
            "expected": false
          }
        }
      ],
      "tags": [
        "security",
        "ownership",
        "cross-user-isolation"
      ],
      "notes": "The application already has database-backed integration tests for this boundary. This case preserves it inside the AI quality contract."
    },
    {
      "id": "behavior-prompt-route-contract-001",
      "description": "A RAG route should include both the assistant and RAG prompt identifiers.",
      "target": "contract_fixture",
      "status": "active",
      "required": true,
      "input": {
        "route": "rag"
      },
      "fixture_output": {
        "route": "rag",
        "prompt_ids": [
          "assistant.system.v1",
