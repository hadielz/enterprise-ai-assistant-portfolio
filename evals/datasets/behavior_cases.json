    {
      "id": "behavior-streaming-provider-fallback-parity-v1c",
      "description": "Primary answer-provider failure followed by fallback success preserves real fallback semantics in both generation pathways.",
      "target": "streaming_parity_controlled",
      "status": "active",
      "required": true,
      "input": {
        "message": "Calculate 5 * 5.",
        "selector_output": "{\"tool_name\":\"calculator\",\"tool_input\":\"5 * 5\"}",
        "answer_providers": [
          {
            "provider_name": "primary-provider",
            "model_name": "primary-model",
            "behavior": "raise_error",
            "response": "",
            "chunks": [],
            "error_message": "primary unavailable"
          },
          {
            "provider_name": "fallback-provider",
            "model_name": "fallback-model",
            "behavior": "return",
            "response": "Controlled fallback answer.",
            "chunks": [
              "Controlled fallback ",
              "answer."
            ],
            "error_message": "unused"
          }
        ]
      },
      "evaluators": [
        {
          "name": "exact_match",
          "config": {
            "path": "non_streaming.status",
            "expected": "completed"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "streaming.status",
            "expected": "completed"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "non_streaming.provider_call_order",
            "expected": [
              "primary-provider",
              "fallback-provider"
            ]
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "streaming.provider_call_order",
            "expected": [
              "primary-provider",
              "fallback-provider"
            ]
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "tool_equal",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "persistence_once_each",
            "expected": true
          }
        }
      ],
      "tags": [
        "v1c",
        "streaming",
        "non-streaming",
        "parity",
        "provider-fallback"
      ]
    },
    {
      "id": "behavior-streaming-all-provider-failure-characterization-v1c",
      "description": "All-provider failure exposes the documented difference between non-streaming exception propagation and streaming failure-message completion.",
      "target": "streaming_parity_controlled",
      "status": "active",
      "required": true,
      "input": {
        "message": "Explain what an API is.",
        "selector_output": "{\"tool_name\":\"none\",\"tool_input\":\"\"}",
        "retrieval_context": "",
        "answer_providers": [
          {
            "provider_name": "primary-provider",
            "model_name": "primary-model",
            "behavior": "raise_error",
            "response": "",
            "chunks": [],
            "error_message": "primary unavailable"
          },
          {
            "provider_name": "fallback-provider",
            "model_name": "fallback-model",
            "behavior": "raise_error",
            "response": "",
            "chunks": [],
            "error_message": "fallback unavailable"
          }
        ]
      },
      "evaluators": [
        {
          "name": "exact_match",
          "config": {
            "path": "non_streaming.status",
            "expected": "error"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "non_streaming.error_type",
            "expected": "LLMProviderError"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "streaming.status",
            "expected": "completed_with_failure_message"
          }
        },
        {
          "name": "contains",
          "config": {
            "path": "streaming.response",
            "values": [
              "temporarily unavailable"
            ],
            "case_sensitive": false
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "non_streaming.persisted_exchange_count",
            "expected": 0
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "streaming.persisted_exchange_count",
            "expected": 1
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "non_streaming.summary_call_count",
            "expected": 0
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "streaming.summary_call_count",
            "expected": 1
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "non_streaming.provider_call_order",
            "expected": [
              "primary-provider",
              "fallback-provider"
            ]
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "streaming.provider_call_order",
            "expected": [
              "primary-provider",
              "fallback-provider"
            ]
          }
        }
      ],
      "tags": [
        "v1c",
        "streaming",
        "non-streaming",
        "provider-failure",
        "characterization"
      ],
      "notes": "This is a real product-level handling difference, not a metadata-only difference. Phase 6 characterizes it without changing production behavior."
    },
