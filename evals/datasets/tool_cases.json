    {
      "id": "tool-provider-fallback-v1c",
      "description": "A primary-provider execution failure followed by fallback success must use the real fallback chain and preserve provider identity metadata.",
      "target": "provider_fallback_controlled",
      "status": "active",
      "required": true,
      "input": {
        "message": "Calculate 7 * 8.",
        "providers": [
          {
            "configured_name": "primary",
            "provider_name": "primary-provider",
            "model_name": "primary-model",
            "behavior": "raise_error",
            "response": "",
            "error_message": "controlled primary failure"
          },
          {
            "configured_name": "fallback",
            "provider_name": "fallback-provider",
            "model_name": "fallback-model",
            "behavior": "return",
            "response": "{\"tool_name\": \"calculator\", \"tool_input\": \"7 * 8\"}",
            "error_message": "controlled fallback failure"
          }
        ]
      },
      "evaluators": [
        {
          "name": "exact_match",
          "config": {
            "path": "provider_succeeded",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "provider",
            "expected": "fallback-provider"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "model",
            "expected": "fallback-model"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "fallback_used",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "provider_call_order",
            "expected": [
              "primary-provider",
              "fallback-provider"
            ]
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "selection_status",
            "expected": "selected"
          }
        },
        {
          "name": "tool_match",
          "config": {
            "expected": "calculator"
          }
        }
      ],
      "tags": [
        "v1c",
        "provider-fallback",
        "tool-selection",
        "phase3"
      ],
      "notes": "This active case executes the real production get_llm_provider() and ResilientLLMProvider.generate_with_metadata() with deterministic local providers."
    },
    {
      "id": "tool-provider-fallback-primary-success-v1c",
      "description": "The primary provider succeeds and no fallback provider is called.",
      "target": "provider_fallback_controlled",
      "status": "active",
      "required": true,
      "input": {
        "message": "Calculate 2 + 3.",
        "providers": [
          {
            "configured_name": "primary",
            "provider_name": "primary-provider",
            "model_name": "primary-model",
            "behavior": "return",
            "response": "{\"tool_name\": \"calculator\", \"tool_input\": \"2 + 3\"}",
            "error_message": "unused primary failure"
          },
          {
            "configured_name": "fallback",
            "provider_name": "fallback-provider",
            "model_name": "fallback-model",
            "behavior": "return",
            "response": "{\"tool_name\": \"calculator\", \"tool_input\": \"999\"}",
            "error_message": "unused fallback failure"
          }
        ]
      },
      "evaluators": [
        {
          "name": "exact_match",
          "config": {
            "path": "provider_succeeded",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "provider",
            "expected": "primary-provider"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "model",
            "expected": "primary-model"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "fallback_used",
            "expected": false
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "provider_call_order",
            "expected": [
              "primary-provider"
            ]
          }
        },
        {
          "name": "tool_match",
          "config": {
            "expected": "calculator"
          }
        }
      ],
      "tags": [
        "v1c",
        "provider-fallback",
        "primary-success",
        "phase3"
      ]
    },
    {
      "id": "tool-provider-fallback-multiple-failures-v1c",
      "description": "Multiple provider execution failures are attempted in configured order before a later provider succeeds.",
      "target": "provider_fallback_controlled",
      "status": "active",
      "required": true,
      "input": {
        "message": "Create a ticket for my VPN issue.",
        "providers": [
          {
            "configured_name": "primary",
            "provider_name": "primary-provider",
            "model_name": "primary-model",
            "behavior": "raise_error",
            "response": "",
            "error_message": "primary unavailable"
          },
          {
            "configured_name": "fallback-one",
            "provider_name": "fallback-one-provider",
            "model_name": "fallback-one-model",
            "behavior": "raise_error",
            "response": "",
            "error_message": "fallback one unavailable"
          },
          {
            "configured_name": "fallback-two",
            "provider_name": "fallback-two-provider",
            "model_name": "fallback-two-model",
            "behavior": "return",
            "response": "{\"tool_name\": \"ticket_creator\", \"tool_input\": \"VPN issue\"}",
            "error_message": "unused"
          }
        ]
      },
      "evaluators": [
        {
          "name": "exact_match",
          "config": {
            "path": "provider",
            "expected": "fallback-two-provider"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "model",
            "expected": "fallback-two-model"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "fallback_used",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "provider_call_order",
            "expected": [
              "primary-provider",
              "fallback-one-provider",
              "fallback-two-provider"
            ]
          }
        },
        {
          "name": "tool_match",
          "config": {
            "expected": "ticket_creator"
          }
        }
      ],
      "tags": [
        "v1c",
        "provider-fallback",
        "ordered-failures",
        "phase3"
      ]
    },
    {
      "id": "tool-provider-fallback-all-fail-v1c",
      "description": "When every configured provider fails, the existing LLMProviderError contract is preserved.",
      "target": "provider_fallback_controlled",
      "status": "active",
      "required": true,
      "input": {
        "message": "Explain an API.",
        "providers": [
          {
            "configured_name": "primary",
