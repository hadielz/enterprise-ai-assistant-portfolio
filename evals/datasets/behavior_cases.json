    {
      "id": "behavior-streaming-no-tool-characterization-v1c",
      "description": "Valid no-tool plus empty retrieval has semantic chat parity despite the known route-label representation difference.",
      "target": "streaming_parity_controlled",
      "status": "active",
      "required": true,
      "input": {
        "message": "Explain what an API is.",
        "selector_output": "{\"tool_name\":\"none\",\"tool_input\":\"\"}",
        "retrieval_context": "",
        "retrieval_sources": [],
        "answer_providers": [
          {
            "provider_name": "primary-answer-provider",
            "model_name": "primary-answer-model",
            "behavior": "return",
            "response": "Controlled final answer.",
            "chunks": [
              "Controlled ",
              "final answer."
            ],
            "error_message": "unused"
          }
        ]
      },
      "evaluators": [
        {
          "name": "exact_match",
          "config": {
            "path": "selection_status_equal",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "non_streaming.selection_status",
            "expected": "no_tool"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "streaming.selection_status",
            "expected": "no_tool"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "semantic_mode_equal",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "non_streaming.effective_answer_mode",
            "expected": "chat"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "streaming.effective_answer_mode",
            "expected": "chat"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "non_streaming.route",
            "expected": "rag"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "streaming.route",
            "expected": "chat"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "route_equal",
            "expected": false
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "known_route_representation_difference",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "retrieval_used_equal",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "prompt_contract_equal",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "persistence_once_each",
            "expected": true
          }
        }
      ],
      "tags": [
        "v1c",
        "streaming",
        "non-streaming",
        "parity",
        "no-tool",
        "representation-difference"
      ],
      "notes": "This intentionally preserves Phase 5 semantics: LangGraph records route=rag while streaming keeps route=chat when retrieval is empty. Both effectively answer as chat."
    },
