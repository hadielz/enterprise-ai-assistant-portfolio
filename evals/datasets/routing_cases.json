{
  "name": "routing_cases",
  "description": "Deterministic route-selection contracts.",
  "cases": [
    {
      "id": "routing-calculator-explicit-001",
      "description": "An explicit arithmetic request is expected to use the tool route.",
      "target": "contract_fixture",
      "status": "active",
      "required": true,
      "input": {
        "message": "Calculate 18 * 27."
      },
      "fixture_output": {
        "route": "tool",
        "tool_name": "calculator",
        "prompt_ids": [
          "assistant.system.v1",
          "tool.answer.v1"
        ]
      },
      "evaluators": [
        {
          "name": "route_match",
          "config": {
            "expected": "tool"
          }
        },
        {
          "name": "tool_match",
          "config": {
            "expected": "calculator"
          }
        },
        {
          "name": "prompt_match",
          "config": {
            "expected": [
              "assistant.system.v1",
              "tool.answer.v1"
            ]
          }
        }
      ],
      "tags": [
        "routing",
        "calculator",
        "v1b-contract"
      ],
      "notes": "A correct arithmetic answer alone is insufficient; the selected route must also be correct."
    },
    {
