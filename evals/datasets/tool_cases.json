    {
      "id": "tool-selector-valid-no-tool-v1c",
      "description": "A valid no-tool response is explicitly classified as no_tool.",
      "target": "tool_selector_controlled",
      "status": "active",
      "required": true,
      "input": {
        "message": "Explain what an API is.",
        "provider_output": "{\"tool_name\": \"none\", \"tool_input\": \"\"}"
      },
      "evaluators": [
        {
          "name": "exact_match",
          "config": {
            "path": "selection_status",
            "expected": "no_tool"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "valid_no_tool_decision",
            "expected": true
          }
        },
        {
          "name": "tool_match",
          "config": {
            "expected": null
          }
        }
      ],
      "tags": [
