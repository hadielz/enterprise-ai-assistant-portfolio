              "rag.answer.v1"
            ]
          }
        }
      ],
      "tags": [
        "prompt-versioning",
        "metadata",
        "rag"
      ]
    },
    {
      "id": "behavior-streaming-parity-v1c",
      "description": "Explicit calculator requests preserve equivalent tool semantics across the real non-streaming LangGraph and manual streaming pathways.",
      "target": "streaming_parity_controlled",
      "status": "active",
      "required": true,
      "input": {
        "message": "Calculate 15 * 4.",
        "selector_output": "{\"tool_name\":\"calculator\",\"tool_input\":\"15 * 4\"}",
        "answer_providers": [
          {
            "provider_name": "primary-answer-provider",
            "model_name": "primary-answer-model",
            "behavior": "return",
            "response": "Controlled final answer.",
            "chunks": [
              "Controlled ",
              "final answer."
            ],
            "error_message": "unused"
          }
        ]
      },
      "evaluators": [
        {
          "name": "exact_match",
          "config": {
            "path": "route_equal",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "semantic_mode_equal",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "tool_equal",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "tool_result_equal",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "selection_status_equal",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "prompt_contract_equal",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "persistence_once_each",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "summary_once_each",
            "expected": true
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "non_streaming.route",
            "expected": "tool"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "streaming.route",
            "expected": "tool"
          }
        },
        {
          "name": "exact_match",
          "config": {
            "path": "non_streaming.tool_name",
            "expected": "calculator"
          }
        },
        {
          "name": "contains",
          "config": {
            "path": "non_streaming.tool_result.tool_result",
            "values": [
              "60"
            ],
            "case_sensitive": true
          }
        }
      ],
      "tags": [
        "v1c",
        "streaming",
        "non-streaming",
        "parity",
        "calculator"
      ],
      "notes": "Activated in Phase 6. This executes both real production chat pathways with deterministic dependencies; parity is based on workflow semantics, not tokenization."
    },
